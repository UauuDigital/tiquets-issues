# Token d'accés de GitHub amb permís per crear issues.
# Recomanat: token "fine-grained" limitat NOMÉS al repositori de tiquets,
# amb el permís de repositori "Issues: Read and write".
# Es genera a: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Els repositoris disponibles (nom visible + owner/repo de GitHub) es
# gestionen en calent des de /admin.html (es desen a repos.json).

# Token secret per accedir a /admin.html i l'API /api/admin/repos.
# Tria una cadena llarga i aleatòria; sense això la gestió de repositoris
# queda desactivada.
ADMIN_TOKEN=

# Port on escoltarà el servidor (opcional, per defecte 3000)
PORT=3000

# --- Notificació per correu (opcional) ---
# Si s'omplen aquestes 4 variables, cada tiquet nou envia també un correu
# (a més de crear l'issue a GitHub). Si es deixen buides, simplement no
# s'envia cap correu.
# Exemple amb Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, i una
# "contrasenya d'aplicació" (no la contrasenya normal del compte).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adreça que rebrà l'avís de cada tiquet nou
NOTIFY_EMAIL=

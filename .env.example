# Token d'accés de GitHub amb permís per crear issues.
# Recomanat: token "fine-grained" limitat NOMÉS al repositori de tiquets,
# amb el permís de repositori "Issues: Read and write".
# Es genera a: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Token del compte propietari real dels repositoris (p. ex. UauuDigital, NO
# UauuBot), usat només per gestionar tiquets ja creats des de /tickets-admin.html
# (canviar estat, canviar prioritat, eliminar). Cal perquè GitHub només permet
# eliminar issues des del compte propietari, no des d'un col·laborador encara
# que tingui rol d'Admin. Permís de repositori necessari: "Issues: Read and write".
GITHUB_ADMIN_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Els repositoris disponibles (nom visible + owner/repo de GitHub) es
# gestionen en calent des de /admin.html (es desen a repos.json).

# Token secret per accedir a /admin.html i l'API /api/admin/repos.
# Tria una cadena llarga i aleatòria; sense això la gestió de repositoris
# queda desactivada.
ADMIN_TOKEN=

# Port on escoltarà el servidor (opcional, per defecte 3000)
PORT=3000

# --- Notificació per correu (opcional) ---
# Si s'omplen aquestes 4 variables, cada tiquet nou envia també un correu
# (a més de crear l'issue a GitHub). Si es deixen buides, simplement no
# s'envia cap correu.
# Exemple amb Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, i una
# "contrasenya d'aplicació" (no la contrasenya normal del compte).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adreça que rebrà l'avís de cada tiquet nou
NOTIFY_EMAIL=

# --- Accés controlat (Supabase Auth + Resend) ---
# Projecte de Supabase compartit amb l'app "compras". Totes les nostres
# taules viuen a l'esquema `tiquets` (mai a `public`).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret: mai s'envia al navegador. Salta la RLS: nomes el backend l'ha de fer servir.
SUPABASE_SERVICE_ROLE_KEY=

# Clau d'API de Resend (resend.com) per als correus que enviem nosaltres
# (verificacio d'email, notificacio a l'admin, rebuig). Els correus de
# magic link i d'invitacio els envia Supabase directament (per defecte, o
# configurat amb SMTP de Resend des del propi panell de Supabase).
RESEND_API_KEY=
# Adreça remitent verificada a Resend.
RESEND_FROM_EMAIL=

# Adreces (separades per comes) que reben la notificacio de sol·licituds
# noves pendents d'aprovar.
ADMIN_NOTIFY_EMAILS=

# URL publica on esta desplegat el portal (sense / final), usada per
# construir els enllaços dels correus que enviem nosaltres.
PUBLIC_BASE_URL=http://localhost:3000
